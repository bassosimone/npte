#!/bin/bash
#
# npte-exec: Run a command inside a namespace.
#
# Usage: npte-exec <client|router|server> <command...>
#
# Must run as root (e.g., via sudo). The command itself runs as the
# invoking user ($SUDO_USER), not as root. This is a Bernstein
# pipeline: nsenter enters the namespace as root, then runuser drops
# privileges before executing the command.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "error: must run as root" >&2
    exit 1
fi

if [[ -z "${SUDO_USER:-}" ]]; then
    echo "error: must run via sudo (need \$SUDO_USER)" >&2
    exit 1
fi

if [[ $# -lt 2 ]]; then
    echo "usage: npte-exec <client|router|server> <command...>" >&2
    exit 1
fi

ns="npte-$1"
shift

set -x
exec nsenter --net="/var/run/netns/$ns" -- runuser -u "$SUDO_USER" -- "$@"
