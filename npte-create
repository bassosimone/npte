#!/bin/bash
#
# npte-create: Create the network performance testing environment.
#
# Topology:
#
#   Host ←(nat)→ Client NS (10.0.1.1) ←veth→ Router NS (10.0.1.2 | 10.0.2.1) ←veth→ Server NS (10.0.2.2) ←(nat)→ Host
#
# Both client and server have internet access via NAT through the host.
# Test traffic between client and server passes through the router,
# where netem shaping is applied. Internet traffic bypasses the router.
#
# The router namespace has IP forwarding enabled. The client and server
# namespaces have their own net.ipv4.tcp_rmem/tcp_wmem (which are
# per-namespace), tuned for high BDP paths. Note: net.core.rmem_max
# and wmem_max are global and cannot be set per-namespace.
#
# Must run as root.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "error: must run as root" >&2
    exit 1
fi

set -x

# Create namespaces
ip netns add npte-client
ip netns add npte-router
ip netns add npte-server

# --- Client ↔ Router veth pair ---
ip link add npte-cr-c type veth peer name npte-cr-r
ip link set npte-cr-c netns npte-client
ip link set npte-cr-r netns npte-router

# --- Router ↔ Server veth pair ---
ip link add npte-rs-r type veth peer name npte-rs-s
ip link set npte-rs-r netns npte-router
ip link set npte-rs-s netns npte-server

# --- Client ↔ Host veth pair (for internet access) ---
ip link add npte-ch-h type veth peer name npte-ch-c
ip link set npte-ch-c netns npte-client

# --- Server ↔ Host veth pair (for internet access) ---
ip link add npte-sh-h type veth peer name npte-sh-s
ip link set npte-sh-s netns npte-server

# Configure host end of NAT veths
ip addr add 10.0.0.1/24 dev npte-ch-h
ip link set npte-ch-h up
ip addr add 10.0.3.1/24 dev npte-sh-h
ip link set npte-sh-h up

# Configure client namespace
ip netns exec npte-client ip link set lo up
ip netns exec npte-client ip addr add 10.0.0.2/24 dev npte-ch-c
ip netns exec npte-client ip link set npte-ch-c up
ip netns exec npte-client ip addr add 10.0.1.1/24 dev npte-cr-c
ip netns exec npte-client ip link set npte-cr-c up
# Server traffic goes through router; everything else goes through host
ip netns exec npte-client ip route add 10.0.2.0/24 via 10.0.1.2
ip netns exec npte-client ip route add default via 10.0.0.1
# Tune per-namespace TCP buffer limits for high BDP paths
ip netns exec npte-client sysctl -w net.ipv4.tcp_rmem="4096 131072 33554432" >/dev/null
ip netns exec npte-client sysctl -w net.ipv4.tcp_wmem="4096 131072 33554432" >/dev/null

# Configure router namespace
ip netns exec npte-router ip link set lo up
ip netns exec npte-router ip addr add 10.0.1.2/24 dev npte-cr-r
ip netns exec npte-router ip addr add 10.0.2.1/24 dev npte-rs-r
ip netns exec npte-router ip link set npte-cr-r up
ip netns exec npte-router ip link set npte-rs-r up
ip netns exec npte-router sysctl -w net.ipv4.ip_forward=1 >/dev/null

# Configure server namespace
ip netns exec npte-server ip link set lo up
ip netns exec npte-server ip addr add 10.0.2.2/24 dev npte-rs-s
ip netns exec npte-server ip link set npte-rs-s up
ip netns exec npte-server ip addr add 10.0.3.2/24 dev npte-sh-s
ip netns exec npte-server ip link set npte-sh-s up
# Client traffic goes through router; everything else goes through host
ip netns exec npte-server ip route add 10.0.1.0/24 via 10.0.2.1
ip netns exec npte-server ip route add default via 10.0.3.1
# Tune per-namespace TCP buffer limits for high BDP paths
ip netns exec npte-server sysctl -w net.ipv4.tcp_rmem="4096 131072 33554432" >/dev/null
ip netns exec npte-server sysctl -w net.ipv4.tcp_wmem="4096 131072 33554432" >/dev/null

# Enable NAT on the host for client and server internet access
sysctl -w net.ipv4.ip_forward=1 >/dev/null
iptables -t nat -A POSTROUTING -s 10.0.0.2/32 -j MASQUERADE
iptables -t nat -A POSTROUTING -s 10.0.3.2/32 -j MASQUERADE

# Allow forwarding for npte interfaces (Docker sets FORWARD policy to DROP)
iptables -I FORWARD -i npte-ch-h -j ACCEPT
iptables -I FORWARD -o npte-ch-h -j ACCEPT
iptables -I FORWARD -i npte-sh-h -j ACCEPT
iptables -I FORWARD -o npte-sh-h -j ACCEPT
