#!/bin/bash
#
# npte-destroy: Tear down the network performance testing environment.
#
# Deleting a namespace automatically cleans up any veth endpoints
# inside it. We also explicitly remove host-side veths and routes.
#
# Must run as root.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "error: must run as root" >&2
    exit 1
fi

set -x

# Remove forwarding rules (ignore errors if already gone)
iptables -D FORWARD -i npte-sh-h -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -o npte-sh-h -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -i npte-ch-h -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -o npte-ch-h -j ACCEPT 2>/dev/null || true

# Remove NAT rules (ignore errors if already gone)
iptables -t nat -D POSTROUTING -s 10.0.3.2/32 -j MASQUERADE 2>/dev/null || true
iptables -t nat -D POSTROUTING -s 10.0.0.2/32 -j MASQUERADE 2>/dev/null || true

# Remove host-side veths (peers inside namespaces are auto-removed)
ip link del npte-sh-h 2>/dev/null || true
ip link del npte-ch-h 2>/dev/null || true

# Deleting namespaces cleans up their remaining interfaces
ip netns del npte-server 2>/dev/null || true
ip netns del npte-router 2>/dev/null || true
ip netns del npte-client 2>/dev/null || true
