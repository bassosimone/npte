#!/bin/bash
#
# npte-shell: Enter a distribution tree interactively.
#
# Usage: npte-shell <name> <namespace>
#
# Opens an interactive shell inside the tree at .npte/trees/<name>
# using systemd-nspawn, joined to the npte-<namespace> network namespace.
#
# The namespace must exist (run npte-create first). Both client and
# server namespaces have internet access via NAT through the host.
#
# Must run as root.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "error: must run as root" >&2
    exit 1
fi

if [[ $# -ne 2 ]]; then
    echo "usage: npte-shell <name> <namespace>" >&2
    exit 1
fi

name="$1"
ns="$2"
tree=".npte/trees/$name"

if [[ ! -d "$tree" ]]; then
    echo "error: tree not found: $tree" >&2
    echo "hint: create it with: npte-bootstrap $name" >&2
    exit 1
fi

set -x
exec systemd-nspawn -D "$tree" --network-namespace-path="/var/run/netns/npte-$ns"
